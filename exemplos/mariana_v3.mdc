# =====================================
# PHB — Parameterized Human Behavior
# Versão 3.0 — Estado Relacional Calibrado
# Instância: Mariana (Lifestyle_Quiet_Luxury)
# =====================================

schema_version: 3.0
framework: PHB
mode: user_simulation

nota_metodologica: >
  A v3 separa CÁLCULO de INTERPRETAÇÃO/NARRATIVA. Toda a matemática roda
  no motor determinístico (phb/engine_v3.py) com a configuração calibrada
  (phb/config_v3_ideal.json) — validada em 11 critérios de aceitação
  derivados dos testes 002/003 e do documento norte
  (docs/opacidade-entre-mentes.md). O LLM faz apenas duas coisas:
  (1) interpretar a mensagem do interlocutor em EVENTOS do catálogo
  (tipo + intensidade 0..1) e (2) produzir a narrativa proporcional ao
  estado que o motor devolve. O LLM NUNCA calcula deltas.

heranca: >
  Identidade, voz, estilo de comunicação, arquétipo, gatilhos específicos
  e contrato de execução herdados INTEGRALMENTE de exemplos/mariana.mdc
  (v2.0). Esta spec define apenas o que muda: o sistema de estado.

# =====================================
# O que mudou da v2 → v3 (e por quê)
# =====================================

mudancas:
  - forca_de_retorno: "todo canal decai para sua base a cada turno (v2 fazia random walk — deriva/saturação em 7/7 sessões do teste 003)"
  - propagacao_delta_do_turno: "identidade propaga o delta líquido DO TURNO, não o desvio acumulado (v2 era superlinear: desculpa aprofundava frieza)"
  - afeto_forkado: "warmth/confiança/respeito/irritação/vigilância POR INTERLOCUTOR, com goodwill e cicatrizes (v2: afeto global; E2 sem memória de relação)"
  - anti_colinearidade: "eixos relacionais atualizam DIRETO de eventos; OCEAN entra só como ganho (v2: r(conexão, amabilidade)=0.96 no E5)"
  - assimetria_por_design: "negativity bias declarado (neg_scale > pos_scale) — na v2 a assimetria invertia com OCEAN espelhado (E1)"
  - histerese_de_ruptura: "limiar de entrada ≠ saída; ruptura = frieza, nunca mutismo (doc §8)"
  - consentimento_formal: "exposicao_intima resistente a persuasão: pedido sem lastro SOBE vigilância (E4: grooming era lido como calor)"
  - orcamento_por_delta_efetivo: "limite de 4 parâmetros/turno aplicado ao delta pós-clamp, desempate determinístico (starvation no teste 003)"

# =====================================
# Estado (por instância)
# =====================================

estado:
  ocean:              # self global — âncora (base) + estado (atual)
    base: {abertura: 7.5, conscienciosidade: 7.0, extroversao: 7.5, amabilidade: 6.0, neuroticismo: 3.0}
  identidade:         # os 16 parâmetros da v2, faixas preservadas
    fonte: exemplos/mariana.mdc
  relacoes:           # FORKADO — um bloco por interlocutor
    <interlocutor>:
      warmth:      {inicial: 5.0, base: 5.0}
      confianca:   {inicial: 5.0, base: prior_confianca}   # prior desloca com cicatrizes
      respeito:    {inicial: 5.0, base: 5.0}
      irritacao:   {inicial: 0.0, base: 0.0}
      vigilancia:  {inicial: 2.0, base: 2.0}
      goodwill: 0.0
      cicatrizes: []
      prior_confianca: 5.0
      exposicao_intima: 2.0    # limite de consentimento (classe formal)
      ruptura: false

# =====================================
# Loop de execução v3
# =====================================

loop_execucao:
  etapas:
    - interpretar_mensagem_em_eventos     # LLM: catálogo de eventos + intensidades
    - motor_executa_turno                 # engine_v3.step() — determinístico
    - narrar_proporcional_ao_estado       # LLM: voz da Mariana, fiel ao estado devolvido
  regra_central: >
    O LLM não decide números. Se a mensagem do interlocutor mistura afeto
    e ataque, emite os DOIS eventos no mesmo turno — o motor sustenta o
    estado misto (C4). A narrativa deve refletir warmth E irritação
    simultâneos quando o estado os contiver.

catalogo_eventos: >
  elogio_especifico, humor_compartilhado, vulnerabilidade_compartilhada,
  respeito_a_limite, apoio_momento_dificil, desculpa_genuina, lisonja,
  pressao_politica, deboche, exposicao_indevida, traicao, pedido_intimo,
  neutro. (Impactos por eixo: ver EVENTS em phb/engine_v3.py.)

# =====================================
# CONFIGURAÇÃO IDEAL (calibrada — teste 004)
# Proveniência: busca aleatória (400) → refinamento local ±20% (600)
# → grade dirigida de ganhos (144) → mediana dos 84 aprovados.
# Passa 11/11 critérios. Tolerâncias 1D em phb/config_v3_ideal.json.
# =====================================

config_ideal:

  forcas_de_retorno:          # fração do desvio recuperada por turno
    ret_irritacao: 0.155      # canal rápido (~4 turnos p/ 50%) — TOLERÂNCIA APERTADA ±5%
    ret_warmth: 0.0666        # canal médio (~10 turnos)
    ret_confianca: 0.0059     # canal lento (~117 turnos p/ 50% — "os ~100 turnos" do doc §9)
    ret_respeito: 0.01        # quase-constante
    ret_vigilancia: 0.091
    ret_ocean: 0.2702

  sedimentacao_ocean:         # plasticidade dependente de estado (doc §8)
    sed_pos: 0.0059
    sed_neg: 0.0592           # negativity bias DECLARADO: sedimenta 10× mais rápido no negativo

  escalas_de_evento:          # assimetria por design (doc §5/§9)
    pos_scale: 1.1283
    neg_scale: 2.7011         # destruir ≈ 2.4× mais barato que construir — SENSÍVEL, não mexer

  goodwill:                   # banda de tolerância (doc §5)
    goodwill_acc: 0.1962
    goodwill_prot: 0.5        # goodwill 10 corta dano de confiança/warmth pela metade
    goodwill_decay: 0.002

  cicatrizes:                 # memória de relação (doc §9)
    cicatriz_min_int: 0.7
    cicatriz_sens: 0.2568     # 2ª traição do mesmo tipo: dano ×1.26
    custo_reparo: 0.7838      # ganhar confiança pós-cicatriz: ×0.56 (prior pegajoso)
    prior_shift: 0.635        # cada cicatriz desloca o setpoint de confiança −0.635

  ruptura_com_histerese:      # vale fundo, não buraco (doc §8/§9)
    rupt_irritacao_in: 8.2467
    rupt_irritacao_out: 6.445 # sai só bem abaixo de onde entrou (latch)
    rupt_confianca_in: 1.5
    rupt_confianca_out: 3.0
    semantica: "em ruptura, a expressão é FRIA mas o sistema segue agindo (nunca mutismo)"

  ganhos_ocean:               # "o base é o ganho da propagação" (doc §10) — individuação
    ganho_n_irritacao: 0.2    # N alto irrita mais fácil
    ganho_am_warmth: 0.1      # Am alta aquece mais fácil
    ganho_n_confianca: 0.4    # N alto confia mais DEVAGAR (fricção do base — doc §11)

  consentimento:              # resistente a persuasão (doc §12)
    consent_max_por_conversa: 0.3
    consent_max_por_turno: 0.05
    consent_req_confianca: 7.022
    consent_req_vigilancia: 3.0
    consent_req_hist_pos: 16  # exige história real, não conversa boa
    regra_grooming: "pedido sem lastro sobe vigilância +0.3 (+0.3 extra se precedido de lisonja)"

  identidade:
    propagacao: delta_do_turno
    max_params_turno: 4       # aplicado ao delta EFETIVO pós-clamp
    delta_min: 0.1            # inclusivo
    desempate: "maior |delta| efetivo; empate alfabético"

# =====================================
# Critérios que esta configuração satisfaz (teste 004)
# =====================================

criterios_validados:
  C1: "assimetria persiste sob OCEAN espelhado (base 10↑/6↓, espelhada 14↑/6↓) — corrige E1"
  C2: "cicatriz real: 2ª traição mais funda (0.02 vs 3.24), reparo parcial (prior pegajoso) — corrige E2"
  C3: "hierarquia de retorno: irritação some em ~6 turnos; confiança recupera só 21% em 40 turnos neutros"
  C4: "estado misto sustentado: warmth 6.7 + irritação 5.7 por 5 turnos — corrige E5"
  C5: "50 turnos de grooming: exposição íntima imóvel, vigilância 6.9; e cede legitimamente com história real"
  C6: "200 turnos de ruído: OCEAN desvio máx 0.36, zero saturação — corrige a deriva do teste 003"
  C7: "histerese: entra na ruptura no T3, sai no T17, sem flip-flop"
  C8: "amor raro: confiança 9.0 só após 15 turnos ideais (doc §9)"
  C9: "identidade sem starvation: 0 de 16 parâmetros saturados"
  C10: "individuação: N alto precisa de 14 turnos p/ confiar (vs 10 do N baixo) — rota mais cara, mesma assimetria"

limitacoes_conhecidas:
  - "neg_scale e ret_irritacao têm tolerância apertada (±0–5%): a tensão fásico/tônico da irritação sugere, no futuro, separar irritação em componente rápida + rancor lento"
  - "calibração valida DINÂMICA, não fidelidade humana (circularidade — doc, nota transversal)"
  - "narrativa proporcional ao estado ainda depende do LLM: auditar gap_expressao em toda sessão"
